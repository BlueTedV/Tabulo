## =========================================================================
## Standard .gitignore for .NET / C# / WPF Projects (Visual Studio / VS Code / Rider)
## =========================================================================

# Build results and compiled binaries
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
arm/
arm64/
bld/
[Ll]og/
[Ll]ogs/

# Visual Studio temporary files, caches, and user settings
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.dbmdl
*.jfm

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# JetBrains Rider & ReSharper
.idea/
*.DotSettings.user
_ReSharper*/

# Test results and code coverage
TestResults/
[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml
coverage*.info

# NuGet Packages and restore artifacts
*.nupkg
packages/
!**/packages.config

# Crash dumps and memory profiling
*.dmp
*.dump
*.stackdump
*.crash

# Operating System generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
