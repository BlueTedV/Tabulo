<Window x:Class="Tabulo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tabulo.ViewModels"
        xmlns:views="clr-namespace:Tabulo.Views"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        mc:Ignorable="d"
        Title="Tabulo — Professional Multi-Table Canvas" 
        Height="780" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        PreviewMouseDown="MainWindow_PreviewMouseDown">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleBoldCommand}"/>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ToggleItalicCommand}"/>
        <KeyBinding Key="U" Modifiers="Control" Command="{Binding ToggleUnderlineCommand}"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding ToggleStrikethroughCommand}"/>
        <KeyBinding Key="NumPad5" Modifiers="Control" Command="{Binding ToggleStrikethroughCommand}"/>
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutSelectionCommand}"/>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectionCommand}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteClipboardCommand}"/>
        <KeyBinding Key="D0" Modifiers="Control+Shift" Command="{Binding FitAllTablesCommand}"/>
        <KeyBinding Key="NumPad0" Modifiers="Control+Shift" Command="{Binding FitAllTablesCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveDocumentCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDocumentCommand}"/>
        <KeyBinding Key="Down" Modifiers="Control" Command="{Binding ToggleFormulaBarExpandedCommand}"/>
        <KeyBinding Key="Up" Modifiers="Control" Command="{Binding ToggleFormulaBarExpandedCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Compact 2-Tier Icon Button Style -->
        <Style x:Key="ToolBtnCompact" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="1.5,1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="100"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="50"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown 2-Tier Toolbar Button Style -->
        <Style x:Key="DropdownToolBtnCompact" TargetType="Button" BasedOn="{StaticResource ToolBtnCompact}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="5,0,5,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Toggle 2-Tier Toolbar Button Style -->
        <Style x:Key="ToggleToolBtnCompact" TargetType="ToggleButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="1.5,1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="100"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="50"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#BFDBFE"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Micro Stepper Button Style for font size up/down arrows -->
        <Style x:Key="MicroStepperBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Font Size Spinner ComboBox Style: No chevron, micro-steppers ▲/▼, editable, and dropdown popup -->
        <Style x:Key="FontSizeSpinnerComboStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="4,3"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Editable text box: centered text, allows typing numbers/backspace -->
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Center"
                                             FontFamily="{TemplateBinding FontFamily}"
                                             FontSize="{TemplateBinding FontSize}"
                                             FontWeight="{TemplateBinding FontWeight}"
                                             Foreground="{TemplateBinding Foreground}"
                                             Padding="2,0,0,0"/>

                                    <!-- Micro Stepper buttons (▲ and ▼) - NO CHEVRON ARROW! -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,1,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="11"/>
                                            <RowDefinition Height="11"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Command="{Binding DataContext.IncreaseFontSizeCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}" 
                                                Style="{StaticResource MicroStepperBtn}" ToolTip="Increase Font Size">
                                            <Path Data="M 1,4.5 L 4,1.5 L 7,4.5" Stroke="#475569" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button Grid.Row="1" Command="{Binding DataContext.DecreaseFontSizeCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}" 
                                                Style="{StaticResource MicroStepperBtn}" ToolTip="Decrease Font Size">
                                            <Path Data="M 1,1.5 L 4,4.5 L 7,1.5" Stroke="#475569" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Popup list of sizes -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide"
                                   StaysOpen="True"
                                   Focusable="False">
                                <Border x:Name="dropDownBorder"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MaxHeight="220"
                                        Width="56"
                                        Margin="0,2,0,0"
                                        Padding="2"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.15" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard ToolBtn -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="100"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="50"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Toolbar Button Style -->
        <Style x:Key="DropdownToolBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="7,0,7,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Modern Context Menu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="AccentToolBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerToolBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
        </Style>

        <!-- TabControl Styling -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Tabbed Toolbars -->
            <RowDefinition Height="Auto"/> <!-- Formula Bar -->
            <RowDefinition Height="*"/>    <!-- Canvas -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Section: Clean Tabbed Navigation Bar with App Logo -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- App Brand Logo & Name -->
                <Border DockPanel.Dock="Left" Padding="14,0,16,0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox Source="/Resources/Icons/app-logo.svg" Width="20" Height="20" Margin="0,0,8,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Tabulo" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Toolbars TabControl -->
                <TabControl Background="#FFFFFF" BorderThickness="0" Padding="0">
                    <!-- TAB 1: HOME (Compact 2-Tier Layout) -->
                    <TabItem Header="Home">
                        <Border Background="#FFFFFF" Padding="6,3" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <!-- Group 1: File & Clipboard -->
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0,0,6,0" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 1: Save, Open, Undo, Redo -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding SaveDocumentCommand}">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Save Workspace (Ctrl+S)"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/save.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding OpenDocumentCommand}">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Open Workspace (Ctrl+O)"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/folder-open.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,1"/>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding UndoCommand}" IsEnabled="{Binding UndoRedo.CanUndo}">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="{Binding UndoRedo.UndoDescription, StringFormat='Undo (Ctrl+Z): {0}'}"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/undo.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding RedoCommand}" IsEnabled="{Binding UndoRedo.CanRedo}">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="{Binding UndoRedo.RedoDescription, StringFormat='Redo (Ctrl+Y): {0}'}"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/redo.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Row 2: Cut, Copy, Paste, Clear -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding CutSelectionCommand}">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Cut Selection (Ctrl+X)"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/cut.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding CopySelectionCommand}">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Copy Selection (Ctrl+C)"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/copy.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding PasteClipboardCommand}">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Paste (Ctrl+V)"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/paste.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding ClearSelectedCellsCommand}">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Clear Selection Content (Del)"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/clear.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Group 2: Font & Typography -->
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0,0,6,0" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 1: Font Family, Font Size with Micro-Steppers, Case Tools -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <ComboBox ItemsSource="{Binding AvailableFontFamilies}" 
                                                      SelectedItem="{Binding ActiveFontFamily, Mode=OneWay}"
                                                      SelectionChanged="FontFamilyComboBox_SelectionChanged"
                                                      Width="120" Height="25" Margin="1,0" FontSize="11.5"
                                                      VerticalContentAlignment="Center"
                                                      ToolTip="Font Family"/>

                                            <!-- Font Size Spinner ComboBox: Custom Size, Auto-Dropdown on click, Micro-Steppers ▲/▼ -->
                                            <ComboBox x:Name="FontSizeComboBox"
                                                      Style="{StaticResource FontSizeSpinnerComboStyle}"
                                                      ItemsSource="{Binding AvailableFontSizes}" 
                                                      SelectedItem="{Binding ActiveFontSize, Mode=OneWay}"
                                                      Text="{Binding ActiveFontSizeText, Mode=OneWay}"
                                                      PreviewMouseLeftButtonDown="FontSizeComboBox_PreviewMouseLeftButtonDown"
                                                      GotKeyboardFocus="FontSizeComboBox_GotKeyboardFocus"
                                                      KeyDown="FontSizeComboBox_KeyDown"
                                                      LostFocus="FontSizeComboBox_LostFocus"
                                                      SelectionChanged="FontSizeComboBox_SelectionChanged"
                                                      ToolTip="Font Size (Click to show list, type custom size, or use ▲/▼)"/>

                                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,1"/>

                                            <!-- Change Case: Capitalize, Lowercase, UPPERCASE -->
                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding ChangeSelectedCellsCaseCommand}" CommandParameter="capitalize">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Capitalize Each Word (Title Case)"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/case-capitalize.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding ChangeSelectedCellsCaseCommand}" CommandParameter="lower">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="lowercase (Convert content to lowercase)"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/case-lower.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding ChangeSelectedCellsCaseCommand}" CommandParameter="upper">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="UPPERCASE (Convert content to all capitals)"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/case-upper.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Row 2: Bold, Italic, Underline, Strikethrough, Font Color, Fill Color, Clear Format -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                            <ToggleButton Style="{StaticResource ToggleToolBtnCompact}" 
                                                          IsChecked="{Binding ActiveIsBold, Mode=OneWay}"
                                                          Command="{Binding ToggleBoldCommand}">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Bold (Ctrl+B)"/>
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/bold.svg" Width="12" Height="12" IsHitTestVisible="False"/>
                                            </ToggleButton>

                                            <ToggleButton Style="{StaticResource ToggleToolBtnCompact}" 
                                                          IsChecked="{Binding ActiveIsItalic, Mode=OneWay}"
                                                          Command="{Binding ToggleItalicCommand}">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Italic (Ctrl+I)"/>
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/italic.svg" Width="12" Height="12" IsHitTestVisible="False"/>
                                            </ToggleButton>

                                            <ToggleButton Style="{StaticResource ToggleToolBtnCompact}" 
                                                          IsChecked="{Binding ActiveIsUnderline, Mode=OneWay}"
                                                          Command="{Binding ToggleUnderlineCommand}">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Underline (Ctrl+U)"/>
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/underline.svg" Width="12" Height="12" IsHitTestVisible="False"/>
                                            </ToggleButton>

                                            <ToggleButton Style="{StaticResource ToggleToolBtnCompact}" 
                                                          IsChecked="{Binding ActiveIsStrikethrough, Mode=OneWay}"
                                                          Command="{Binding ToggleStrikethroughCommand}">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Strikethrough (Ctrl+5)"/>
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/strikethrough.svg" Width="12" Height="12" IsHitTestVisible="False"/>
                                            </ToggleButton>

                                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,1"/>

                                            <!-- Font Color Dropdown -->
                                            <Button Style="{StaticResource DropdownToolBtnCompact}" 
                                                    Click="DropdownMenuButton_Click"
                                                    ContextMenuOpening="DropdownMenuButton_ContextMenuOpening"
                                                    ToolTip="Font Color">
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Automatic (Default)" Command="{Binding SetForegroundColorCommand}" CommandParameter="Default">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#1E293B" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator Margin="0,2"/>
                                                        <MenuItem Header="Black" Command="{Binding SetForegroundColorCommand}" CommandParameter="#000000">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#000000" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Slate Gray" Command="{Binding SetForegroundColorCommand}" CommandParameter="#475569">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#475569" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Crimson Red" Command="{Binding SetForegroundColorCommand}" CommandParameter="#DC2626">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#DC2626" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Amber Orange" Command="{Binding SetForegroundColorCommand}" CommandParameter="#D97706">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#D97706" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Emerald Green" Command="{Binding SetForegroundColorCommand}" CommandParameter="#16A34A">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#16A34A" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Royal Blue" Command="{Binding SetForegroundColorCommand}" CommandParameter="#2563EB">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#2563EB" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Purple" Command="{Binding SetForegroundColorCommand}" CommandParameter="#7C3AED">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#7C3AED" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator Margin="0,2"/>
                                                        <MenuItem Header="Custom Color..." Click="OpenCustomFontColor_Click">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/palette.svg" Width="15" Height="15"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Grid VerticalAlignment="Center" Margin="0,0,3,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <svgc:SvgViewbox Source="/Resources/Icons/font-color.svg" Width="13" Height="12" IsHitTestVisible="False"/>
                                                        <Border Grid.Row="1" Height="3" Width="13" Margin="0,1,0,0" CornerRadius="1"
                                                                BorderBrush="#40000000" BorderThickness="0.5"
                                                                Background="{Binding ActiveForegroundColor, FallbackValue='#1E293B', TargetNullValue='#1E293B'}"/>
                                                    </Grid>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/chevron-down.svg" Width="7" Height="7" IsHitTestVisible="False"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Fill Color Dropdown -->
                                            <Button Style="{StaticResource DropdownToolBtnCompact}" 
                                                    Click="DropdownMenuButton_Click"
                                                    ContextMenuOpening="DropdownMenuButton_ContextMenuOpening"
                                                    ToolTip="Fill Color (Cell Background)">
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="No Fill (Transparent)" Command="{Binding SetBackgroundColorCommand}" CommandParameter="Transparent">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="White" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator Margin="0,2"/>
                                                        <MenuItem Header="Light Yellow" Command="{Binding SetBackgroundColorCommand}" CommandParameter="#FEF3C7">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#FEF3C7" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Light Green" Command="{Binding SetBackgroundColorCommand}" CommandParameter="#DCFCE7">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#DCFCE7" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Light Blue" Command="{Binding SetBackgroundColorCommand}" CommandParameter="#DBEAFE">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#DBEAFE" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Light Red" Command="{Binding SetBackgroundColorCommand}" CommandParameter="#FEE2E2">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#FEE2E2" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Light Gray" Command="{Binding SetBackgroundColorCommand}" CommandParameter="#F1F5F9">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#F1F5F9" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Navy Slate" Command="{Binding SetBackgroundColorCommand}" CommandParameter="#1E293B">
                                                            <MenuItem.Icon>
                                                                <Border Width="16" Height="16" Background="#1E293B" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator Margin="0,2"/>
                                                        <MenuItem Header="Custom Color..." Click="OpenCustomFillColor_Click">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/palette.svg" Width="15" Height="15"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Grid VerticalAlignment="Center" Margin="0,0,3,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <svgc:SvgViewbox Source="/Resources/Icons/paint-bucket.svg" Width="13" Height="12" IsHitTestVisible="False"/>
                                                        <Border Grid.Row="1" Height="3" Width="13" Margin="0,1,0,0" CornerRadius="1"
                                                                BorderBrush="#94A3B8" BorderThickness="0.5"
                                                                Background="{Binding ActiveBackgroundColor, FallbackValue='Transparent', TargetNullValue='Transparent'}"/>
                                                    </Grid>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/chevron-down.svg" Width="7" Height="7" IsHitTestVisible="False"/>
                                                </StackPanel>
                                            </Button>

                                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,1"/>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding ClearFormattingCommand}">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Clear Formatting (Reset styles to default)"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/format-clear.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Group 3: Alignment & Text Flow -->
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0,0,6,0" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 1: Vertical Alignments & Text Wrap -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding SetVerticalAlignmentCommand}" CommandParameter="top">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Align Top"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/align-top.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding SetVerticalAlignmentCommand}" CommandParameter="center">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Align Middle (Center)"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/align-middle.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding SetVerticalAlignmentCommand}" CommandParameter="bottom">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Align Bottom"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/align-bottom.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,1"/>

                                            <ToggleButton Style="{StaticResource ToggleToolBtnCompact}" 
                                                          IsChecked="{Binding ActiveWrapText, Mode=OneWay}"
                                                          Command="{Binding ToggleWrapTextCommand}" Width="56">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Wrap Text (Toggle text wrapping within column)"/>
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <svgc:SvgViewbox Source="/Resources/Icons/wrap-text.svg" Width="12" Height="12" Margin="0,0,3,0" IsHitTestVisible="False"/>
                                                    <TextBlock Text="Wrap" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ToggleButton>
                                        </StackPanel>

                                        <!-- Row 2: Horizontal Alignments -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding SetAlignmentCommand}" CommandParameter="left">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Align Left"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/align-left.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding SetAlignmentCommand}" CommandParameter="center">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Align Center"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/align-center.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding SetAlignmentCommand}" CommandParameter="right">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Align Right"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <svgc:SvgViewbox Source="/Resources/Icons/align-right.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Group 4: Number Format & Table Operations -->
                                <Border Padding="0,0,2,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 1: Number Format Dropdown -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Button Style="{StaticResource DropdownToolBtnCompact}" 
                                                    Click="DropdownMenuButton_Click"
                                                    ContextMenuOpening="DropdownMenuButton_ContextMenuOpening"
                                                    Width="118">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Number Format"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="General (Normal)" Command="{Binding SetNumberFormatCommand}">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/format-general.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Currency ($#,##0.00)" Command="{Binding SetNumberFormatCommand}" CommandParameter="C2">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/format-currency.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Currency (No Cents - $#,##0)" Command="{Binding SetNumberFormatCommand}" CommandParameter="C0">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/format-currency-0.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Percentage (0.0%)" Command="{Binding SetNumberFormatCommand}" CommandParameter="P1">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/format-percent.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Comma Number (#,##0.00)" Command="{Binding SetNumberFormatCommand}" CommandParameter="N2">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/format-comma.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Integer (#,##0)" Command="{Binding SetNumberFormatCommand}" CommandParameter="N0">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/format-integer.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator Margin="0,2"/>
                                                        <MenuItem Header="Short Date (yyyy-MM-dd)" Command="{Binding SetNumberFormatCommand}" CommandParameter="yyyy-MM-dd">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/calendar.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <svgc:SvgViewbox Source="/Resources/Icons/format-number.svg" Width="13" Height="13" Margin="0,0,4,0" IsHitTestVisible="False"/>
                                                    <TextBlock Text="Number Format" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/chevron-down.svg" Width="7" Height="7" IsHitTestVisible="False"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Row 2: Quick Formats & Modify Table -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding SetNumberFormatCommand}" CommandParameter="C2" ToolTip="Format Currency ($)" Width="22">
                                                <TextBlock Text="$" FontSize="11" FontWeight="Bold"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding SetNumberFormatCommand}" CommandParameter="P1" ToolTip="Format Percentage (%)" Width="22">
                                                <TextBlock Text="%" FontSize="10.5" FontWeight="Bold"/>
                                            </Button>

                                            <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding SetNumberFormatCommand}" CommandParameter="N2" ToolTip="Format Comma (,)" Width="22">
                                                <TextBlock Text="," FontSize="12" FontWeight="Bold"/>
                                            </Button>

                                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,1"/>

                                            <!-- Modify Table Dropdown -->
                                            <Button Style="{StaticResource DropdownToolBtnCompact}" 
                                                    Click="DropdownMenuButton_Click"
                                                    ContextMenuOpening="DropdownMenuButton_ContextMenuOpening"
                                                    ToolTip="Modify Table Rows &amp; Columns">
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Insert Row Above" Command="{Binding InsertRowAboveCommand}">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/row-insert-above.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Insert Row Below" Command="{Binding InsertRowBelowCommand}">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/row-insert-below.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator Margin="0,2"/>
                                                        <MenuItem Header="Insert Column Left" Command="{Binding InsertColumnLeftCommand}">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/col-insert-left.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Insert Column Right" Command="{Binding InsertColumnRightCommand}">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/col-insert-right.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator Margin="0,2"/>
                                                        <MenuItem Header="Delete Active Row" Command="{Binding DeleteRowCommand}">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/row-delete.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Delete Active Column" Command="{Binding DeleteColumnCommand}">
                                                            <MenuItem.Icon>
                                                                <svgc:SvgViewbox Source="/Resources/Icons/col-delete.svg" Width="16" Height="16"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <svgc:SvgViewbox Source="/Resources/Icons/table-edit.svg" Width="13" Height="13" Margin="0,0,3,0" IsHitTestVisible="False"/>
                                                    <TextBlock Text="Rows &amp; Cols" FontSize="11" FontWeight="SemiBold" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/chevron-down.svg" Width="7" Height="7" IsHitTestVisible="False"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>
                    </TabItem>

                <!-- TAB 2: TABLE & STRUCTURE (Compact 2-Tier Layout) -->
                <TabItem Header="Table &amp; Insert">
                    <Border Background="#FFFFFF" Padding="6,3" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Group 1: Tables -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0,0,6,0" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: New Table, Duplicate Table -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Button Style="{StaticResource DropdownToolBtnCompact}" Command="{Binding AddTableCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="Insert Table" FontWeight="Bold"/>
                                                        <TextBlock Text="Place a new independent table block on the infinite canvas." Foreground="#64748B"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <svgc:SvgViewbox Source="/Resources/Icons/table-add.svg" Width="13" Height="13" Margin="0,0,4,0" IsHitTestVisible="False"/>
                                                <TextBlock Text="New Table" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding DuplicateTableCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="Duplicate Table" FontWeight="Bold"/>
                                                        <TextBlock Text="Create a clone of the active table with all data and formulas." Foreground="#64748B"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <svgc:SvgViewbox Source="/Resources/Icons/table-duplicate.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Row 1: Delete Table -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                        <Button Style="{StaticResource DropdownToolBtnCompact}" Command="{Binding DeleteTableCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="Delete Active Table" FontWeight="Bold"/>
                                                        <TextBlock Text="Remove the currently selected table from the canvas." Foreground="#64748B"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <svgc:SvgViewbox Source="/Resources/Icons/trash.svg" Width="12" Height="12" Margin="0,0,4,0" IsHitTestVisible="False"/>
                                                <TextBlock Text="Delete Table" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Group 2: Rows & Columns Operations -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0,0,6,0" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Rows & Columns Menu + Quick Insert Row Above/Below -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Button Style="{StaticResource DropdownToolBtnCompact}" 
                                                Click="DropdownMenuButton_Click"
                                                ContextMenuOpening="DropdownMenuButton_ContextMenuOpening">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="Rows &amp; Columns" FontWeight="Bold"/>
                                                        <TextBlock Text="Insert or delete rows and columns relative to active cell." Foreground="#64748B"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Insert Row Above" Command="{Binding InsertRowAboveCommand}">
                                                        <MenuItem.Icon>
                                                            <svgc:SvgViewbox Source="/Resources/Icons/row-insert-above.svg" Width="16" Height="16"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Insert Row Below" Command="{Binding InsertRowBelowCommand}">
                                                        <MenuItem.Icon>
                                                            <svgc:SvgViewbox Source="/Resources/Icons/row-insert-below.svg" Width="16" Height="16"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Margin="0,2"/>
                                                    <MenuItem Header="Insert Column Left" Command="{Binding InsertColumnLeftCommand}">
                                                        <MenuItem.Icon>
                                                            <svgc:SvgViewbox Source="/Resources/Icons/col-insert-left.svg" Width="16" Height="16"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Insert Column Right" Command="{Binding InsertColumnRightCommand}">
                                                        <MenuItem.Icon>
                                                            <svgc:SvgViewbox Source="/Resources/Icons/col-insert-right.svg" Width="16" Height="16"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Margin="0,2"/>
                                                    <MenuItem Header="Delete Active Row" Command="{Binding DeleteRowCommand}">
                                                        <MenuItem.Icon>
                                                            <svgc:SvgViewbox Source="/Resources/Icons/row-delete.svg" Width="16" Height="16"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Delete Active Column" Command="{Binding DeleteColumnCommand}">
                                                        <MenuItem.Icon>
                                                            <svgc:SvgViewbox Source="/Resources/Icons/col-delete.svg" Width="16" Height="16"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <svgc:SvgViewbox Source="/Resources/Icons/table-edit.svg" Width="13" Height="13" Margin="0,0,3,0" IsHitTestVisible="False"/>
                                                <TextBlock Text="Rows &amp; Columns" FontSize="11" FontWeight="SemiBold" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <svgc:SvgViewbox Source="/Resources/Icons/chevron-down.svg" Width="7" Height="7" IsHitTestVisible="False"/>
                                            </StackPanel>
                                        </Button>

                                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,1"/>

                                        <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding InsertRowAboveCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="Insert Row Above"/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <svgc:SvgViewbox Source="/Resources/Icons/row-insert-above.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                        </Button>

                                        <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding InsertRowBelowCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="Insert Row Below"/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <svgc:SvgViewbox Source="/Resources/Icons/row-insert-below.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Row 1: Insert Col Left/Right + Delete Row/Col -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                        <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding InsertColumnLeftCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="Insert Column Left"/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <svgc:SvgViewbox Source="/Resources/Icons/col-insert-left.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                        </Button>

                                        <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding InsertColumnRightCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="Insert Column Right"/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <svgc:SvgViewbox Source="/Resources/Icons/col-insert-right.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                        </Button>

                                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,1"/>

                                        <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding DeleteRowCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="Delete Active Row"/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <svgc:SvgViewbox Source="/Resources/Icons/row-delete.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                        </Button>

                                        <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding DeleteColumnCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="Delete Active Column"/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <svgc:SvgViewbox Source="/Resources/Icons/col-delete.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Group 3: Table Styling / Header Color -->
                            <Border Padding="0,0,2,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Table Theme Color Dropdown with Color indicator -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Button Style="{StaticResource DropdownToolBtnCompact}" 
                                                Click="DropdownMenuButton_Click"
                                                ContextMenuOpening="DropdownMenuButton_ContextMenuOpening">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="Table Theme Color" FontWeight="Bold"/>
                                                        <TextBlock Text="Change header banner accent color for the active table." Foreground="#64748B"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="Default">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <Border Width="24" Height="14" Background="#334155" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                                <TextBlock Text="Default Slate" VerticalAlignment="Center" FontWeight="Medium"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="#1E3A8A">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <Border Width="24" Height="14" Background="#1E3A8A" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                                <TextBlock Text="Navy Blue" VerticalAlignment="Center" FontWeight="Medium"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="#065F46">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <Border Width="24" Height="14" Background="#065F46" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                                <TextBlock Text="Emerald Green" VerticalAlignment="Center" FontWeight="Medium"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="#991B1B">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <Border Width="24" Height="14" Background="#991B1B" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                                <TextBlock Text="Crimson Red" VerticalAlignment="Center" FontWeight="Medium"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="#92400E">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <Border Width="24" Height="14" Background="#92400E" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                                <TextBlock Text="Amber Orange" VerticalAlignment="Center" FontWeight="Medium"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="#5B21B6">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <Border Width="24" Height="14" Background="#5B21B6" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                                <TextBlock Text="Royal Purple" VerticalAlignment="Center" FontWeight="Medium"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="#0F766E">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <Border Width="24" Height="14" Background="#0F766E" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                                <TextBlock Text="Ocean Teal" VerticalAlignment="Center" FontWeight="Medium"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <Separator Margin="0,2"/>
                                                    <MenuItem Header="Custom Color..." Click="OpenCustomTableHeaderColor_Click">
                                                        <MenuItem.Icon>
                                                            <svgc:SvgViewbox Source="/Resources/Icons/palette.svg" Width="15" Height="15"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid VerticalAlignment="Center" Margin="0,0,3,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/table-header-color.svg" Width="13" Height="12" IsHitTestVisible="False"/>
                                                    <Border Grid.Row="1" Height="3" Width="13" Margin="0,1,0,0" CornerRadius="1"
                                                            BorderBrush="#40000000" BorderThickness="0.5"
                                                            Background="{Binding ActiveTable.HeaderColor, FallbackValue='#334155', TargetNullValue='#334155'}"/>
                                                </Grid>
                                                <TextBlock Text="Header Color" FontSize="11" FontWeight="SemiBold" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <svgc:SvgViewbox Source="/Resources/Icons/chevron-down.svg" Width="7" Height="7" IsHitTestVisible="False"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Row 1: Custom Color button -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                        <Button Style="{StaticResource DropdownToolBtnCompact}" Click="OpenCustomTableHeaderColor_Click" ToolTip="Custom Table Color...">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <svgc:SvgViewbox Source="/Resources/Icons/palette.svg" Width="12" Height="12" Margin="0,0,3,0" IsHitTestVisible="False"/>
                                                <TextBlock Text="Custom..." FontSize="10.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 3: DATA & VIEW (Compact 2-Tier Layout) -->
                <TabItem Header="Data &amp; View">
                    <Border Background="#FFFFFF" Padding="6,3" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Group 1: Calculation -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0,0,6,0" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Recalculate All -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Button Style="{StaticResource DropdownToolBtnCompact}" Command="{Binding RecalculateAllCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="Recalculate All (F9)" FontWeight="Bold"/>
                                                        <TextBlock Text="Re-evaluates the entire calculation graph across all canvas tables." Foreground="#64748B"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <svgc:SvgViewbox Source="/Resources/Icons/bolt.svg" Width="13" Height="13" Margin="0,0,4,0" IsHitTestVisible="False"/>
                                                <TextBlock Text="Calculate All" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Row 1: Status badge -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                                        <Border Background="#F1F5F9" CornerRadius="3" Padding="6,2" Height="25">
                                            <TextBlock Text="Auto Compute" FontSize="10" Foreground="#16A34A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Group 2: Zoom & Viewport -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0,0,6,0" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Zoom Controls -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding ZoomOutCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="Zoom Out (Ctrl+MouseWheel Down)"/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <svgc:SvgViewbox Source="/Resources/Icons/zoom-out.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                        </Button>

                                        <Border Background="#F1F5F9" CornerRadius="3" Padding="4,2" Margin="1.5,1" Height="25" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" Width="38" TextAlignment="Center" FontWeight="SemiBold" Foreground="#334155" FontSize="11" VerticalAlignment="Center"/>
                                        </Border>

                                        <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding ZoomInCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="Zoom In (Ctrl+MouseWheel Up)"/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <svgc:SvgViewbox Source="/Resources/Icons/zoom-in.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Row 1: Reset 100%, Fit All -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                        <Button Style="{StaticResource ToolBtnCompact}" Command="{Binding ResetZoomCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="Reset Viewport (100% Zoom)"/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <svgc:SvgViewbox Source="/Resources/Icons/zoom-reset.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                        </Button>

                                        <Button Style="{StaticResource DropdownToolBtnCompact}" Command="{Binding FitAllTablesCommand}">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="Fit All Tables (Ctrl+Shift+0)" FontWeight="Bold"/>
                                                        <TextBlock Text="Zoom and pan to fit all canvas tables into view." Foreground="#64748B"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <svgc:SvgViewbox Source="/Resources/Icons/fit-all.svg" Width="13" Height="13" Margin="0,0,3,0" IsHitTestVisible="False"/>
                                                <TextBlock Text="Fit All" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Group 3: View Toggles with Active Highlights -->
                            <Border Padding="0,0,2,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Snap to Grid Toggle -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource ToggleToolBtnCompact}" 
                                                      Width="Auto" Padding="6,0"
                                                      IsChecked="{Binding SnapToGrid, Mode=OneWay}"
                                                      Command="{Binding ToggleSnapToGridCommand}">
                                            <ToggleButton.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="Toggle Snap to Grid (20px)" FontWeight="Bold"/>
                                                        <TextBlock Text="Snap table positions to 20px grid when dragging." Foreground="#64748B"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </ToggleButton.ToolTip>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <svgc:SvgViewbox Source="/Resources/Icons/magnet.svg" Width="12" Height="12" Margin="0,0,4,0" IsHitTestVisible="False"/>
                                                <TextBlock Text="Snap to Grid" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>

                                    <!-- Row 1: Navigator Sidebar Toggle -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                        <ToggleButton Style="{StaticResource ToggleToolBtnCompact}" 
                                                      Width="Auto" Padding="6,0"
                                                      IsChecked="{Binding IsSidebarOpen, Mode=OneWay}"
                                                      Command="{Binding ToggleSidebarCommand}">
                                            <ToggleButton.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="Toggle Navigator Sidebar" FontWeight="Bold"/>
                                                        <TextBlock Text="Show or hide the table outline navigator." Foreground="#64748B"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </ToggleButton.ToolTip>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <svgc:SvgViewbox Source="/Resources/Icons/compass.svg" Width="12" Height="12" Margin="0,0,4,0" IsHitTestVisible="False"/>
                                                <TextBlock Text="Navigator" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>

        <!-- 2. Formula Bar -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/> <!-- Active Cell Reference -->
                        <ColumnDefinition Width="Auto"/> <!-- fx separator -->
                        <ColumnDefinition Width="*"/>    <!-- Formula Input -->
                        <ColumnDefinition Width="Auto"/> <!-- Commit Checkmark -->
                        <ColumnDefinition Width="Auto"/> <!-- Expand/Collapse Toggle -->
                    </Grid.ColumnDefinitions>

                    <!-- Active Cell Box -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Top" Height="28">
                        <TextBlock Text="{Binding ActiveCellAddressText}" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" TextAlignment="Center" FontSize="12"/>
                    </Border>

                    <!-- fx Symbol -->
                    <TextBlock Grid.Column="1" Text="𝑓𝑥" FontSize="14" FontWeight="Bold" Foreground="#64748B" FontStyle="Italic" VerticalAlignment="Top" Margin="12,4,8,0"/>

                    <!-- Formula Text Input with Dynamic Multi-Line Height -->
                    <TextBox Grid.Column="2" 
                             Text="{Binding FormulaBarText, UpdateSourceTrigger=PropertyChanged}" 
                             KeyDown="FormulaBar_KeyDown"
                             PreviewKeyDown="FormulaBar_PreviewKeyDown"
                             TextChanged="FormulaBar_TextChanged"
                             SelectionChanged="FormulaBar_SelectionChanged"
                             GotFocus="FormulaBar_GotFocus"
                             LostFocus="FormulaBar_LostFocus"
                             FontSize="13" 
                             FontFamily="Consolas, Cascadia Code, Segoe UI"
                             VerticalContentAlignment="Top" 
                             Padding="6,4"
                             BorderBrush="#CBD5E1" 
                             Background="#FAFAFA"
                             Name="FormulaBarInput">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="AcceptsReturn" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFormulaBarExpanded}" Value="True">
                                        <Setter Property="Height" Value="95"/>
                                        <Setter Property="AcceptsReturn" Value="True"/>
                                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Commit Button -->
                    <Button Grid.Column="3" 
                            Command="{Binding CommitFormulaBarCommand}" 
                            Width="30" Height="28" 
                            Margin="4,0,0,0" 
                            VerticalAlignment="Top"
                            Background="#F0FDF4" 
                            BorderBrush="#BBF7D0" 
                            Cursor="Hand"
                            ToolTip="Commit Formula (Enter)">
                        <svgc:SvgViewbox Source="/Resources/Icons/check.svg" Width="14" Height="14" IsHitTestVisible="False"/>
                    </Button>

                    <!-- Expand / Collapse Toggle Button -->
                    <Button Grid.Column="4" 
                            Command="{Binding ToggleFormulaBarExpandedCommand}" 
                            Width="30" Height="28" 
                            Margin="4,0,0,0" 
                            VerticalAlignment="Top"
                            Background="#F8FAFC" 
                            BorderBrush="#CBD5E1" 
                            Cursor="Hand"
                            ToolTip="Expand / Collapse Formula Bar (Ctrl+Down / Ctrl+Up)">
                        <Grid>
                            <svgc:SvgViewbox Source="/Resources/Icons/expand.svg" Width="13" Height="13" IsHitTestVisible="False">
                                <svgc:SvgViewbox.Style>
                                    <Style TargetType="svgc:SvgViewbox">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFormulaBarExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </svgc:SvgViewbox.Style>
                            </svgc:SvgViewbox>
                            <svgc:SvgViewbox Source="/Resources/Icons/collapse.svg" Width="13" Height="13" IsHitTestVisible="False">
                                <svgc:SvgViewbox.Style>
                                    <Style TargetType="svgc:SvgViewbox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFormulaBarExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </svgc:SvgViewbox.Style>
                            </svgc:SvgViewbox>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Parameter Hint Bar (Shown dynamically when inside a function call) -->
                <Border Grid.Row="1" 
                        x:Name="FormulaParameterHintBar" 
                        Visibility="Collapsed"
                        Background="#EFF6FF" 
                        BorderBrush="#BFDBFE" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Margin="180,4,68,0" 
                        Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/lightbulb.svg" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="FormulaParameterHintText" 
                                   Text="" 
                                   FontFamily="Consolas, Segoe UI" 
                                   FontSize="11.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="#1E40AF" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Formula Autocomplete Dropdown Popup -->
                <Popup x:Name="FormulaAutocompletePopup" 
                       PlacementTarget="{Binding ElementName=FormulaBarInput}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="#FFFFFF" 
                            BorderBrush="#3B82F6" 
                            BorderThickness="1.5" 
                            CornerRadius="6" 
                            Width="380" 
                            MaxHeight="220" 
                            Padding="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F1F5F9" Padding="8,4" CornerRadius="4,4,0,0">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="Tab / Enter to insert" Foreground="#64748B" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Text="FORMULA FUNCTIONS" FontWeight="Bold" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ListBox Grid.Row="1" 
                                     x:Name="FormulaAutocompleteList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewKeyDown="FormulaAutocompleteList_PreviewKeyDown"
                                     MouseDoubleClick="FormulaAutocompleteList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" Margin="1,1" CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#2563EB" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="2" Padding="4,1" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#64748B"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- 3. Infinite Canvas Viewport & Navigator Sidebar -->
        <Grid Grid.Row="2" Background="#F8FAFC">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Navigator Sidebar (Resizable via GridSplitter) -->
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="180" MaxWidth="500"/>

                <!-- Column 1: GridSplitter Drag Handle -->
                <ColumnDefinition Width="Auto"/>

                <!-- Column 2: Infinite Canvas Viewport -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigator Sidebar -->
            <Border Grid.Column="0" 
                    HorizontalAlignment="Stretch"
                    Background="#F8FAFC" 
                    BorderBrush="#CBD5E1" 
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header with Add Table and Collapse Arrow -->
                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding AddTableCommand}"
                                        Padding="7,3" 
                                        Background="#2563EB" 
                                        Foreground="White" 
                                        BorderThickness="0" 
                                        FontWeight="SemiBold" 
                                        FontSize="11" 
                                        Cursor="Hand" 
                                        Margin="0,0,6,0"
                                        ToolTip="Add a new table to the infinite canvas">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <svgc:SvgViewbox Source="/Resources/Icons/plus.svg" Width="9" Height="9" Margin="0,0,4,0" IsHitTestVisible="False"/>
                                        <TextBlock Text="Table" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ToggleSidebarCommand}"
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Padding="4,2" 
                                        Cursor="Hand" 
                                        ToolTip="Collapse Navigator sidebar">
                                    <svgc:SvgViewbox Source="/Resources/Icons/chevron-left.svg" Width="12" Height="12" IsHitTestVisible="False"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <svgc:SvgViewbox Source="/Resources/Icons/compass.svg" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="NAVIGATOR" FontWeight="Bold" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Tables List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Document.Tables}" Margin="8,8,8,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" 
                                            BorderBrush="#CBD5E1" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Margin="0,0,0,8" 
                                            Padding="8,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Table Color Accent Pill -->
                                            <Border Grid.Column="0" 
                                                    CornerRadius="3" 
                                                    Margin="0,2,0,2"
                                                    Background="{Binding HeaderColor, FallbackValue='#334155', TargetNullValue='#334155'}"/>

                                            <!-- Table Name & Details (Click to Focus, Double Click to Rename) -->
                                            <Button Grid.Column="1" 
                                                    Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Padding="8,0,4,0" 
                                                    HorizontalContentAlignment="Left"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.FocusTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    MouseDoubleClick="NavigatorTableTitle_MouseDoubleClick"
                                                    ToolTip="Click to pan and focus table (Double-click to rename)">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Foreground="#64748B" FontSize="10" Margin="0,2,0,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} cols × {1} rows">
                                                                <Binding Path="ColumnCount"/>
                                                                <Binding Path="RowCount"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>

                                            <!-- Quick Table Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Padding="4,2" 
                                                        Margin="1,0" 
                                                        Cursor="Hand" 
                                                        ToolTip="Rename Table (In-place)"
                                                        Click="NavigatorRenameButton_Click">
                                                    <svgc:SvgViewbox Source="/Resources/Icons/pencil.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                                </Button>
                                                <Button Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Padding="4,2" 
                                                        Margin="1,0" 
                                                        Cursor="Hand" 
                                                        ToolTip="Duplicate Table"
                                                        Command="{Binding DataContext.DuplicateTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <svgc:SvgViewbox Source="/Resources/Icons/copy.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                                </Button>
                                                <Button Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Padding="4,2" 
                                                        Margin="1,0"
                                                        Cursor="Hand" 
                                                        ToolTip="Delete Table"
                                                        Command="{Binding DataContext.DeleteTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <svgc:SvgViewbox Source="/Resources/Icons/trash.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Sidebar Footer Info -->
                    <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <svgc:SvgViewbox Source="/Resources/Icons/lightbulb.svg" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="Click pencil or double-click title to rename" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 1: GridSplitter Draggable Edge -->
            <GridSplitter Grid.Column="1" 
                          x:Name="SidebarSplitter"
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" 
                          ShowsPreview="False" 
                          Cursor="SizeWE"
                          Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisConverter}}">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Background" Value="#E2E8F0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B82F6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- Column 2: Infinite Canvas Viewport -->
            <views:InfiniteCanvasView Grid.Column="2" x:Name="CanvasView" />

            <!-- Floating Re-Open Button when Navigator is Collapsed -->
            <Button Grid.Column="2" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Margin="10,10,0,0"
                    Command="{Binding ToggleSidebarCommand}"
                    Padding="8,5"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="Expand Navigator sidebar">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarOpen}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Source="/Resources/Icons/compass.svg" Width="13" Height="13" Margin="0,0,5,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Navigator" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,4,0"/>
                    <svgc:SvgViewbox Source="/Resources/Icons/chevron-right.svg" Width="9" Height="9" IsHitTestVisible="False"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectionSummaryText}" FontWeight="SemiBold" Foreground="#2563EB" FontSize="11" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Document.Tables.Count, StringFormat={}{0} Tables on Canvas}" Foreground="#64748B" FontSize="11" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="C# &amp; Roslyn Active" Foreground="#16A34A" FontWeight="Medium" FontSize="11" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Linear Undo Stack" Foreground="#64748B" FontSize="11" Margin="8,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleSidebarCommand}" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="3,1" 
                            Margin="0,0,8,0" 
                            Cursor="Hand" 
                            ToolTip="Toggle Navigator Sidebar">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/Resources/Icons/compass.svg" Width="12" Height="12" Margin="0,0,4,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Navigator" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                    <Button Command="{Binding ToggleSnapToGridCommand}" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="3,1" 
                            Margin="6,0,8,0" 
                            Cursor="Hand" 
                            ToolTip="Toggle 20px Grid Snapping">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/Resources/Icons/magnet.svg" Width="12" Height="12" Margin="0,0,4,0" IsHitTestVisible="False"/>
                            <TextBlock FontSize="11" Foreground="#475569">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Snap: 20px"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SnapToGrid}" Value="False">
                                                <Setter Property="Text" Value="Snap: Off"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                    <TextBlock FontSize="11" Foreground="#64748B" Margin="6,0" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Canvas: ({0:F0}, {1:F0}) • Zoom: {2:P0}">
                                <Binding Path="PanX"/>
                                <Binding Path="PanY"/>
                                <Binding Path="Zoom"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" Margin="6,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
