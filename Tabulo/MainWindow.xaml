<Window x:Class="Tabulo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tabulo.ViewModels"
        xmlns:views="clr-namespace:Tabulo.Views"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        mc:Ignorable="d"
        Title="Tabulo — Professional Multi-Table Canvas" 
        Height="780" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="D0" Modifiers="Control+Shift" Command="{Binding FitAllTablesCommand}"/>
        <KeyBinding Key="NumPad0" Modifiers="Control+Shift" Command="{Binding FitAllTablesCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveDocumentCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDocumentCommand}"/>
        <KeyBinding Key="Down" Modifiers="Control" Command="{Binding ToggleFormulaBarExpandedCommand}"/>
        <KeyBinding Key="Up" Modifiers="Control" Command="{Binding ToggleFormulaBarExpandedCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Compact Icon Button Style -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="100"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="50"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Toolbar Button Style -->
        <Style x:Key="DropdownToolBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="7,0,7,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Modern Context Menu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="AccentToolBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerToolBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
        </Style>

        <!-- TabControl Styling -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Tabbed Toolbars -->
            <RowDefinition Height="Auto"/> <!-- Formula Bar -->
            <RowDefinition Height="*"/>    <!-- Canvas -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Section: Clean Tabbed Navigation Bar with App Logo -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- App Brand Logo & Name -->
                <Border DockPanel.Dock="Left" Padding="14,0,16,0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox Source="/Resources/Icons/app-logo.svg" Width="20" Height="20" Margin="0,0,8,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Tabulo" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Toolbars TabControl -->
                <TabControl Background="#FFFFFF" BorderThickness="0" Padding="0">
                    <!-- TAB 1: HOME -->
                    <TabItem Header="Home">
                        <Border Background="#FFFFFF" Padding="8,4" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- File Group -->
                                <Button Style="{StaticResource ToolBtn}" Command="{Binding SaveDocumentCommand}">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Save Workspace (Ctrl+S)" FontWeight="Bold"/>
                                                <TextBlock Text="Save current canvas and tables to a .sheetx / .json document." Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/save.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                                </Button>

                                <Button Style="{StaticResource ToolBtn}" Command="{Binding OpenDocumentCommand}">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Open Workspace (Ctrl+O)" FontWeight="Bold"/>
                                                <TextBlock Text="Open an existing spreadsheet canvas document." Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/folder-open.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                                </Button>

                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                                <!-- Clipboard Group -->
                                <Button Style="{StaticResource ToolBtn}" Command="{Binding CutSelectionCommand}">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Cut Selection (Ctrl+X)" FontWeight="Bold"/>
                                                <TextBlock Text="Copy selected cell contents and clear them." Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/cut.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                                </Button>

                                <Button Style="{StaticResource ToolBtn}" Command="{Binding CopySelectionCommand}">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Copy Selection (Ctrl+C)" FontWeight="Bold"/>
                                                <TextBlock Text="Copy selected cell(s) as TSV to the system clipboard." Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/copy.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                                </Button>

                                <Button Style="{StaticResource ToolBtn}" Command="{Binding PasteClipboardCommand}">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Paste (Ctrl+V)" FontWeight="Bold"/>
                                                <TextBlock Text="Paste TSV data starting at active cell." Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/paste.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                                </Button>

                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                                <!-- History Group -->
                                <Button Style="{StaticResource ToolBtn}" Command="{Binding UndoCommand}" IsEnabled="{Binding UndoRedo.CanUndo}">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Undo (Ctrl+Z)" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding UndoRedo.UndoDescription, StringFormat='Reverts: {0}'}" Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/undo.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                                </Button>

                                <Button Style="{StaticResource ToolBtn}" Command="{Binding RedoCommand}" IsEnabled="{Binding UndoRedo.CanRedo}">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Redo (Ctrl+Y)" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding UndoRedo.RedoDescription, StringFormat='Replays: {0}'}" Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/redo.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                                </Button>

                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                                <!-- Formatting Group -->
                                <Button Style="{StaticResource ToolBtn}" Command="{Binding ToggleBoldCommand}">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Bold (Ctrl+B)" FontWeight="Bold"/>
                                                <TextBlock Text="Toggle bold text styling for active selection." Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/bold.svg" Width="14" Height="14" IsHitTestVisible="False"/>
                                </Button>

                                <Button Style="{StaticResource ToolBtn}" Command="{Binding ToggleItalicCommand}">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Italic (Ctrl+I)" FontWeight="Bold"/>
                                                <TextBlock Text="Toggle italic text styling for active selection." Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/italic.svg" Width="14" Height="14" IsHitTestVisible="False"/>
                                </Button>

                                <Button Style="{StaticResource ToolBtn}" Command="{Binding SetAlignmentCommand}" CommandParameter="left">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Align Left" FontWeight="Bold"/>
                                                <TextBlock Text="Align cell content to the left edge." Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/align-left.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                                </Button>

                                <Button Style="{StaticResource ToolBtn}" Command="{Binding SetAlignmentCommand}" CommandParameter="center">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Align Center" FontWeight="Bold"/>
                                                <TextBlock Text="Center cell content horizontally." Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/align-center.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                                </Button>

                                <Button Style="{StaticResource ToolBtn}" Command="{Binding SetAlignmentCommand}" CommandParameter="right">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Align Right" FontWeight="Bold"/>
                                                <TextBlock Text="Align cell content to the right edge." Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/align-right.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                                </Button>

                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                                <!-- Number Format Dropdown -->
                                <Button Style="{StaticResource DropdownToolBtn}" 
                                        Click="DropdownMenuButton_Click"
                                        ContextMenuOpening="DropdownMenuButton_ContextMenuOpening">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Number Format" FontWeight="Bold"/>
                                                <TextBlock Text="Choose cell display formatting (General, Currency, Percent, etc.)" Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="General (Normal)" Command="{Binding SetNumberFormatCommand}">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/format-general.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Currency ($#,##0.00)" Command="{Binding SetNumberFormatCommand}" CommandParameter="C2">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/format-currency.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Currency (No Cents - $#,##0)" Command="{Binding SetNumberFormatCommand}" CommandParameter="C0">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/format-currency-0.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Percentage (0.0%)" Command="{Binding SetNumberFormatCommand}" CommandParameter="P1">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/format-percent.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Comma Number (#,##0.00)" Command="{Binding SetNumberFormatCommand}" CommandParameter="N2">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/format-comma.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Integer (#,##0)" Command="{Binding SetNumberFormatCommand}" CommandParameter="N0">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/format-integer.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Margin="0,2"/>
                                            <MenuItem Header="Short Date (yyyy-MM-dd)" Command="{Binding SetNumberFormatCommand}" CommandParameter="yyyy-MM-dd">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/calendar.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <svgc:SvgViewbox Source="/Resources/Icons/format-number.svg" Width="14" Height="14" Margin="0,0,4,0" IsHitTestVisible="False"/>
                                        <svgc:SvgViewbox Source="/Resources/Icons/chevron-down.svg" Width="8" Height="8" IsHitTestVisible="False"/>
                                    </StackPanel>
                                </Button>

                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                                <!-- Clear Cell -->
                                <Button Style="{StaticResource ToolBtn}" Command="{Binding ClearSelectedCellsCommand}">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Clear Selection (Del)" FontWeight="Bold"/>
                                                <TextBlock Text="Erase text/formula in selected cells while preserving formatting." Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <svgc:SvgViewbox Source="/Resources/Icons/clear.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                                </Button>

                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                                <!-- Modify Table Dropdown -->
                                <Button Style="{StaticResource DropdownToolBtn}" 
                                        Click="DropdownMenuButton_Click"
                                        ContextMenuOpening="DropdownMenuButton_ContextMenuOpening">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Modify Table" FontWeight="Bold"/>
                                                <TextBlock Text="Insert or delete rows and columns relative to active cell." Foreground="#64748B"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Insert Row Above" Command="{Binding InsertRowAboveCommand}">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/row-insert-above.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Insert Row Below" Command="{Binding InsertRowBelowCommand}">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/row-insert-below.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Margin="0,2"/>
                                            <MenuItem Header="Insert Column Left" Command="{Binding InsertColumnLeftCommand}">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/col-insert-left.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Insert Column Right" Command="{Binding InsertColumnRightCommand}">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/col-insert-right.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Margin="0,2"/>
                                            <MenuItem Header="Delete Active Row" Command="{Binding DeleteRowCommand}">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/row-delete.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Delete Active Column" Command="{Binding DeleteColumnCommand}">
                                                <MenuItem.Icon>
                                                    <svgc:SvgViewbox Source="/Resources/Icons/col-delete.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <svgc:SvgViewbox Source="/Resources/Icons/table-edit.svg" Width="14" Height="14" Margin="0,0,4,0" IsHitTestVisible="False"/>
                                        <TextBlock Text="Modify Table" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <svgc:SvgViewbox Source="/Resources/Icons/chevron-down.svg" Width="8" Height="8" IsHitTestVisible="False"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </TabItem>

                <!-- TAB 2: TABLE & STRUCTURE -->
                <TabItem Header="Table &amp; Insert">
                    <Border Background="#FFFFFF" Padding="8,4" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- New Table -->
                            <Button Style="{StaticResource AccentToolBtn}" Command="{Binding AddTableCommand}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="Insert Table" FontWeight="Bold"/>
                                            <TextBlock Text="Place a new independent table block on the infinite canvas." Foreground="#64748B"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <svgc:SvgViewbox Source="/Resources/Icons/table-add.svg" Width="16" Height="16" IsHitTestVisible="False"/>
                            </Button>

                            <Button Style="{StaticResource DangerToolBtn}" Command="{Binding DeleteTableCommand}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="Delete Active Table" FontWeight="Bold"/>
                                            <TextBlock Text="Remove the currently selected table from the canvas." Foreground="#64748B"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <svgc:SvgViewbox Source="/Resources/Icons/trash.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                            </Button>

                            <Button Style="{StaticResource ToolBtn}" Command="{Binding DuplicateTableCommand}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="Duplicate Table" FontWeight="Bold"/>
                                            <TextBlock Text="Create a clone of the active table with all data and formulas." Foreground="#64748B"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <svgc:SvgViewbox Source="/Resources/Icons/table-duplicate.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                            </Button>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                            <!-- Modify Table Dropdown -->
                            <Button Style="{StaticResource DropdownToolBtn}" 
                                    Click="DropdownMenuButton_Click"
                                    ContextMenuOpening="DropdownMenuButton_ContextMenuOpening">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="Modify Table" FontWeight="Bold"/>
                                            <TextBlock Text="Insert or delete rows and columns relative to active cell." Foreground="#64748B"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Insert Row Above" Command="{Binding InsertRowAboveCommand}">
                                            <MenuItem.Icon>
                                                <svgc:SvgViewbox Source="/Resources/Icons/row-insert-above.svg" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Insert Row Below" Command="{Binding InsertRowBelowCommand}">
                                            <MenuItem.Icon>
                                                <svgc:SvgViewbox Source="/Resources/Icons/row-insert-below.svg" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Margin="0,2"/>
                                        <MenuItem Header="Insert Column Left" Command="{Binding InsertColumnLeftCommand}">
                                            <MenuItem.Icon>
                                                <svgc:SvgViewbox Source="/Resources/Icons/col-insert-left.svg" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Insert Column Right" Command="{Binding InsertColumnRightCommand}">
                                            <MenuItem.Icon>
                                                <svgc:SvgViewbox Source="/Resources/Icons/col-insert-right.svg" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Margin="0,2"/>
                                        <MenuItem Header="Delete Active Row" Command="{Binding DeleteRowCommand}">
                                            <MenuItem.Icon>
                                                <svgc:SvgViewbox Source="/Resources/Icons/row-delete.svg" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Delete Active Column" Command="{Binding DeleteColumnCommand}">
                                            <MenuItem.Icon>
                                                <svgc:SvgViewbox Source="/Resources/Icons/col-delete.svg" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <svgc:SvgViewbox Source="/Resources/Icons/table-edit.svg" Width="14" Height="14" Margin="0,0,4,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="Modify Table" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <svgc:SvgViewbox Source="/Resources/Icons/chevron-down.svg" Width="8" Height="8" IsHitTestVisible="False"/>
                                </StackPanel>
                            </Button>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                            <!-- Table Color Dropdown -->
                            <Button Style="{StaticResource DropdownToolBtn}" 
                                    Click="DropdownMenuButton_Click"
                                    ContextMenuOpening="DropdownMenuButton_ContextMenuOpening">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="Table Theme Color" FontWeight="Bold"/>
                                            <TextBlock Text="Change header banner accent color for the active table." Foreground="#64748B"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="Default">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Border Width="24" Height="14" Background="#334155" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Default Slate" VerticalAlignment="Center" FontWeight="Medium"/>
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="#1E3A8A">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Border Width="24" Height="14" Background="#1E3A8A" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Navy Blue" VerticalAlignment="Center" FontWeight="Medium"/>
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="#065F46">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Border Width="24" Height="14" Background="#065F46" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Emerald Green" VerticalAlignment="Center" FontWeight="Medium"/>
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="#991B1B">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Border Width="24" Height="14" Background="#991B1B" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Crimson Red" VerticalAlignment="Center" FontWeight="Medium"/>
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="#92400E">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Border Width="24" Height="14" Background="#92400E" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Amber Orange" VerticalAlignment="Center" FontWeight="Medium"/>
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="#5B21B6">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Border Width="24" Height="14" Background="#5B21B6" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Royal Purple" VerticalAlignment="Center" FontWeight="Medium"/>
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Command="{Binding SetActiveTableHeaderColorCommand}" CommandParameter="#0F766E">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Border Width="24" Height="14" Background="#0F766E" CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Ocean Teal" VerticalAlignment="Center" FontWeight="Medium"/>
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,5,0"
                                            BorderBrush="#94A3B8" BorderThickness="1"
                                            Background="{Binding ActiveTable.HeaderColor, FallbackValue='#334155', TargetNullValue='#334155'}"/>
                                    <TextBlock Text="Color" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <svgc:SvgViewbox Source="/Resources/Icons/chevron-down.svg" Width="8" Height="8" IsHitTestVisible="False"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 3: DATA & VIEW -->
                <TabItem Header="Data &amp; View">
                    <Border Background="#FFFFFF" Padding="8,4" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Recalculate -->
                            <Button Style="{StaticResource ToolBtn}" Command="{Binding RecalculateAllCommand}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="Recalculate All (F9)" FontWeight="Bold"/>
                                            <TextBlock Text="Re-evaluates the entire calculation graph across all canvas tables." Foreground="#64748B"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <svgc:SvgViewbox Source="/Resources/Icons/bolt.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                            </Button>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                            <!-- Zoom Controls -->
                            <Button Style="{StaticResource ToolBtn}" Command="{Binding ZoomOutCommand}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock Text="Zoom Out (Ctrl+MouseWheel Down)"/>
                                    </ToolTip>
                                </Button.ToolTip>
                                <svgc:SvgViewbox Source="/Resources/Icons/zoom-out.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                            </Button>

                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="2,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" Width="45" TextAlignment="Center" FontWeight="SemiBold" Foreground="#334155" FontSize="11"/>
                            </Border>

                            <Button Style="{StaticResource ToolBtn}" Command="{Binding ZoomInCommand}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock Text="Zoom In (Ctrl+MouseWheel Up)"/>
                                    </ToolTip>
                                </Button.ToolTip>
                                <svgc:SvgViewbox Source="/Resources/Icons/zoom-in.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                            </Button>

                            <Button Style="{StaticResource ToolBtn}" Command="{Binding ResetZoomCommand}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock Text="Reset Viewport (100% Zoom)"/>
                                    </ToolTip>
                                </Button.ToolTip>
                                <svgc:SvgViewbox Source="/Resources/Icons/zoom-reset.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                            </Button>

                            <Button Style="{StaticResource ToolBtn}" Command="{Binding FitAllTablesCommand}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="Fit All Tables (Ctrl+Shift+0)" FontWeight="Bold"/>
                                            <TextBlock Text="Zoom and pan to fit all canvas tables into view." Foreground="#64748B"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <svgc:SvgViewbox Source="/Resources/Icons/fit-all.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                            </Button>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                            <!-- Grid Snapping -->
                            <Button Style="{StaticResource ToolBtn}" Command="{Binding ToggleSnapToGridCommand}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="Toggle Snap to Grid (20px)" FontWeight="Bold"/>
                                            <TextBlock Text="Snap table positions to 20px grid when dragging." Foreground="#64748B"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <svgc:SvgViewbox Source="/Resources/Icons/magnet.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                            </Button>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                            <!-- Navigator Toggle -->
                            <Button Style="{StaticResource ToolBtn}" Command="{Binding ToggleSidebarCommand}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="Toggle Navigator Sidebar" FontWeight="Bold"/>
                                            <TextBlock Text="Show or hide the table outline navigator." Foreground="#64748B"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <svgc:SvgViewbox Source="/Resources/Icons/compass.svg" Width="15" Height="15" IsHitTestVisible="False"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>

        <!-- 2. Formula Bar -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/> <!-- Active Cell Reference -->
                        <ColumnDefinition Width="Auto"/> <!-- fx separator -->
                        <ColumnDefinition Width="*"/>    <!-- Formula Input -->
                        <ColumnDefinition Width="Auto"/> <!-- Commit Checkmark -->
                        <ColumnDefinition Width="Auto"/> <!-- Expand/Collapse Toggle -->
                    </Grid.ColumnDefinitions>

                    <!-- Active Cell Box -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Top" Height="28">
                        <TextBlock Text="{Binding ActiveCellAddressText}" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" TextAlignment="Center" FontSize="12"/>
                    </Border>

                    <!-- fx Symbol -->
                    <TextBlock Grid.Column="1" Text="𝑓𝑥" FontSize="14" FontWeight="Bold" Foreground="#64748B" FontStyle="Italic" VerticalAlignment="Top" Margin="12,4,8,0"/>

                    <!-- Formula Text Input with Dynamic Multi-Line Height -->
                    <TextBox Grid.Column="2" 
                             Text="{Binding FormulaBarText, UpdateSourceTrigger=PropertyChanged}" 
                             KeyDown="FormulaBar_KeyDown"
                             PreviewKeyDown="FormulaBar_PreviewKeyDown"
                             TextChanged="FormulaBar_TextChanged"
                             SelectionChanged="FormulaBar_SelectionChanged"
                             GotFocus="FormulaBar_GotFocus"
                             LostFocus="FormulaBar_LostFocus"
                             FontSize="13" 
                             FontFamily="Consolas, Cascadia Code, Segoe UI"
                             VerticalContentAlignment="Top" 
                             Padding="6,4"
                             BorderBrush="#CBD5E1" 
                             Background="#FAFAFA"
                             Name="FormulaBarInput">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="AcceptsReturn" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFormulaBarExpanded}" Value="True">
                                        <Setter Property="Height" Value="95"/>
                                        <Setter Property="AcceptsReturn" Value="True"/>
                                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Commit Button -->
                    <Button Grid.Column="3" 
                            Command="{Binding CommitFormulaBarCommand}" 
                            Width="30" Height="28" 
                            Margin="4,0,0,0" 
                            VerticalAlignment="Top"
                            Background="#F0FDF4" 
                            BorderBrush="#BBF7D0" 
                            Cursor="Hand"
                            ToolTip="Commit Formula (Enter)">
                        <svgc:SvgViewbox Source="/Resources/Icons/check.svg" Width="14" Height="14" IsHitTestVisible="False"/>
                    </Button>

                    <!-- Expand / Collapse Toggle Button -->
                    <Button Grid.Column="4" 
                            Command="{Binding ToggleFormulaBarExpandedCommand}" 
                            Width="30" Height="28" 
                            Margin="4,0,0,0" 
                            VerticalAlignment="Top"
                            Background="#F8FAFC" 
                            BorderBrush="#CBD5E1" 
                            Cursor="Hand"
                            ToolTip="Expand / Collapse Formula Bar (Ctrl+Down / Ctrl+Up)">
                        <Grid>
                            <svgc:SvgViewbox Source="/Resources/Icons/expand.svg" Width="13" Height="13" IsHitTestVisible="False">
                                <svgc:SvgViewbox.Style>
                                    <Style TargetType="svgc:SvgViewbox">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFormulaBarExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </svgc:SvgViewbox.Style>
                            </svgc:SvgViewbox>
                            <svgc:SvgViewbox Source="/Resources/Icons/collapse.svg" Width="13" Height="13" IsHitTestVisible="False">
                                <svgc:SvgViewbox.Style>
                                    <Style TargetType="svgc:SvgViewbox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFormulaBarExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </svgc:SvgViewbox.Style>
                            </svgc:SvgViewbox>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Parameter Hint Bar (Shown dynamically when inside a function call) -->
                <Border Grid.Row="1" 
                        x:Name="FormulaParameterHintBar" 
                        Visibility="Collapsed"
                        Background="#EFF6FF" 
                        BorderBrush="#BFDBFE" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Margin="180,4,68,0" 
                        Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/lightbulb.svg" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="FormulaParameterHintText" 
                                   Text="" 
                                   FontFamily="Consolas, Segoe UI" 
                                   FontSize="11.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="#1E40AF" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Formula Autocomplete Dropdown Popup -->
                <Popup x:Name="FormulaAutocompletePopup" 
                       PlacementTarget="{Binding ElementName=FormulaBarInput}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="#FFFFFF" 
                            BorderBrush="#3B82F6" 
                            BorderThickness="1.5" 
                            CornerRadius="6" 
                            Width="380" 
                            MaxHeight="220" 
                            Padding="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F1F5F9" Padding="8,4" CornerRadius="4,4,0,0">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="Tab / Enter to insert" Foreground="#64748B" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Text="FORMULA FUNCTIONS" FontWeight="Bold" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ListBox Grid.Row="1" 
                                     x:Name="FormulaAutocompleteList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewKeyDown="FormulaAutocompleteList_PreviewKeyDown"
                                     MouseDoubleClick="FormulaAutocompleteList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" Margin="1,1" CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#2563EB" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="2" Padding="4,1" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#64748B"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- 3. Infinite Canvas Viewport & Navigator Sidebar -->
        <Grid Grid.Row="2" Background="#F8FAFC">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Navigator Sidebar (Resizable via GridSplitter) -->
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="180" MaxWidth="500"/>

                <!-- Column 1: GridSplitter Drag Handle -->
                <ColumnDefinition Width="Auto"/>

                <!-- Column 2: Infinite Canvas Viewport -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigator Sidebar -->
            <Border Grid.Column="0" 
                    HorizontalAlignment="Stretch"
                    Background="#F8FAFC" 
                    BorderBrush="#CBD5E1" 
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header with Add Table and Collapse Arrow -->
                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding AddTableCommand}"
                                        Padding="7,3" 
                                        Background="#2563EB" 
                                        Foreground="White" 
                                        BorderThickness="0" 
                                        FontWeight="SemiBold" 
                                        FontSize="11" 
                                        Cursor="Hand" 
                                        Margin="0,0,6,0"
                                        ToolTip="Add a new table to the infinite canvas">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <svgc:SvgViewbox Source="/Resources/Icons/plus.svg" Width="9" Height="9" Margin="0,0,4,0" IsHitTestVisible="False"/>
                                        <TextBlock Text="Table" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ToggleSidebarCommand}"
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Padding="4,2" 
                                        Cursor="Hand" 
                                        ToolTip="Collapse Navigator sidebar">
                                    <svgc:SvgViewbox Source="/Resources/Icons/chevron-left.svg" Width="12" Height="12" IsHitTestVisible="False"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <svgc:SvgViewbox Source="/Resources/Icons/compass.svg" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="NAVIGATOR" FontWeight="Bold" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Tables List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Document.Tables}" Margin="8,8,8,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" 
                                            BorderBrush="#CBD5E1" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Margin="0,0,0,8" 
                                            Padding="8,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Table Color Accent Pill -->
                                            <Border Grid.Column="0" 
                                                    CornerRadius="3" 
                                                    Margin="0,2,0,2"
                                                    Background="{Binding HeaderColor, FallbackValue='#334155', TargetNullValue='#334155'}"/>

                                            <!-- Table Name & Details (Click to Focus, Double Click to Rename) -->
                                            <Button Grid.Column="1" 
                                                    Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Padding="8,0,4,0" 
                                                    HorizontalContentAlignment="Left"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.FocusTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    MouseDoubleClick="NavigatorTableTitle_MouseDoubleClick"
                                                    ToolTip="Click to pan and focus table (Double-click to rename)">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Foreground="#64748B" FontSize="10" Margin="0,2,0,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} cols × {1} rows">
                                                                <Binding Path="ColumnCount"/>
                                                                <Binding Path="RowCount"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>

                                            <!-- Quick Table Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Padding="4,2" 
                                                        Margin="1,0" 
                                                        Cursor="Hand" 
                                                        ToolTip="Rename Table (In-place)"
                                                        Click="NavigatorRenameButton_Click">
                                                    <svgc:SvgViewbox Source="/Resources/Icons/pencil.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                                </Button>
                                                <Button Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Padding="4,2" 
                                                        Margin="1,0" 
                                                        Cursor="Hand" 
                                                        ToolTip="Duplicate Table"
                                                        Command="{Binding DataContext.DuplicateTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <svgc:SvgViewbox Source="/Resources/Icons/copy.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                                </Button>
                                                <Button Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Padding="4,2" 
                                                        Margin="1,0"
                                                        Cursor="Hand" 
                                                        ToolTip="Delete Table"
                                                        Command="{Binding DataContext.DeleteTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <svgc:SvgViewbox Source="/Resources/Icons/trash.svg" Width="13" Height="13" IsHitTestVisible="False"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Sidebar Footer Info -->
                    <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <svgc:SvgViewbox Source="/Resources/Icons/lightbulb.svg" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="Click pencil or double-click title to rename" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 1: GridSplitter Draggable Edge -->
            <GridSplitter Grid.Column="1" 
                          x:Name="SidebarSplitter"
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" 
                          ShowsPreview="False" 
                          Cursor="SizeWE"
                          Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisConverter}}">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Background" Value="#E2E8F0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B82F6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- Column 2: Infinite Canvas Viewport -->
            <views:InfiniteCanvasView Grid.Column="2" x:Name="CanvasView" />

            <!-- Floating Re-Open Button when Navigator is Collapsed -->
            <Button Grid.Column="2" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Margin="10,10,0,0"
                    Command="{Binding ToggleSidebarCommand}"
                    Padding="8,5"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="Expand Navigator sidebar">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarOpen}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Source="/Resources/Icons/compass.svg" Width="13" Height="13" Margin="0,0,5,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Navigator" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,4,0"/>
                    <svgc:SvgViewbox Source="/Resources/Icons/chevron-right.svg" Width="9" Height="9" IsHitTestVisible="False"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectionSummaryText}" FontWeight="SemiBold" Foreground="#2563EB" FontSize="11" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Document.Tables.Count, StringFormat={}{0} Tables on Canvas}" Foreground="#64748B" FontSize="11" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="C# &amp; Roslyn Active" Foreground="#16A34A" FontWeight="Medium" FontSize="11" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Linear Undo Stack" Foreground="#64748B" FontSize="11" Margin="8,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleSidebarCommand}" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="3,1" 
                            Margin="0,0,8,0" 
                            Cursor="Hand" 
                            ToolTip="Toggle Navigator Sidebar">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/Resources/Icons/compass.svg" Width="12" Height="12" Margin="0,0,4,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Navigator" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                    <Button Command="{Binding ToggleSnapToGridCommand}" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="3,1" 
                            Margin="6,0,8,0" 
                            Cursor="Hand" 
                            ToolTip="Toggle 20px Grid Snapping">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/Resources/Icons/magnet.svg" Width="12" Height="12" Margin="0,0,4,0" IsHitTestVisible="False"/>
                            <TextBlock FontSize="11" Foreground="#475569">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Snap: 20px"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SnapToGrid}" Value="False">
                                                <Setter Property="Text" Value="Snap: Off"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                    <TextBlock FontSize="11" Foreground="#64748B" Margin="6,0" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Canvas: ({0:F0}, {1:F0}) • Zoom: {2:P0}">
                                <Binding Path="PanX"/>
                                <Binding Path="PanY"/>
                                <Binding Path="Zoom"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" Margin="6,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
