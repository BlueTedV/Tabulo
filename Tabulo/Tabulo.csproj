<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tabulo.Core\Tabulo.Core.csproj" />
    <ProjectReference Include="..\Tabulo.Scripting\Tabulo.Scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\*.svg" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Product>Tabulo</Product>
    <AssemblyTitle>Tabulo</AssemblyTitle>
    <Description>Tabulo - Flexible and powerful multi-table spreadsheet editor</Description>
  </PropertyGroup>

</Project>
