<Window x:Class="Tabulo.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Color" Height="530" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Hue Rainbow Slider Style -->
        <Style x:Key="HueSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="360"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Rainbow Track Background -->
                            <Border Height="14" CornerRadius="7" BorderBrush="#CBD5E1" BorderThickness="1" SnapsToDevicePixels="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#FFFF00" Offset="0.167"/>
                                        <GradientStop Color="#00FF00" Offset="0.333"/>
                                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="0.667"/>
                                        <GradientStop Color="#FF00FF" Offset="0.833"/>
                                        <GradientStop Color="#FF0000" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FFFFFF" BorderBrush="#0F172A" BorderThickness="1.5" CornerRadius="4">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Border Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title / Header -->
                <RowDefinition Height="Auto"/> <!-- 2D Color Square -->
                <RowDefinition Height="Auto"/> <!-- Hue Slider -->
                <RowDefinition Height="Auto"/> <!-- Previews + Hex + RGB Readouts -->
                <RowDefinition Height="Auto"/> <!-- Preset Quick Swatches -->
                <RowDefinition Height="*"/>    <!-- Spacer -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="Custom Color Picker" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,10"/>

            <!-- 2D Color Square (Saturation & Brightness Canvas) -->
            <Border Grid.Row="1" Height="180" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True" Background="#000000" Cursor="Cross">
                <Grid x:Name="ColorSquareGrid" 
                      MouseDown="ColorSquare_MouseDown" 
                      MouseMove="ColorSquare_MouseMove" 
                      MouseUp="ColorSquare_MouseUp"
                      SizeChanged="ColorSquare_SizeChanged">
                    
                    <!-- Base Layer: Solid current pure hue -->
                    <Rectangle x:Name="HueRectangle" Fill="#FF0000"/>

                    <!-- Saturation overlay: White to Transparent (horizontal) -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Brightness overlay: Transparent to Black (vertical) -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Draggable High-Contrast Reticle -->
                    <Canvas x:Name="ReticleCanvas" IsHitTestVisible="False">
                        <Grid x:Name="ReticleThumb" Width="16" Height="16" Margin="-8,-8,0,0">
                            <Ellipse Stroke="#000000" StrokeThickness="2.5" Fill="Transparent"/>
                            <Ellipse Stroke="#FFFFFF" StrokeThickness="1.5" Margin="0.5" Fill="Transparent"/>
                        </Grid>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Rainbow Hue Slider -->
            <Slider Grid.Row="2" x:Name="HueSlider" 
                    Style="{StaticResource HueSliderStyle}"
                    ValueChanged="HueSlider_ValueChanged"
                    Margin="0,10,0,12"
                    ToolTip="Hue Slider (0° - 360°)"/>

            <!-- Previews, Hex, and RGB inputs row -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Preview swatches -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Separator -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Hex input -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Separator -->
                        <ColumnDefinition Width="*"/>
                        <!-- RGB Inputs -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current vs New Color Swatches -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="Current" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                            <Border x:Name="CurrentColorBorder" Width="34" Height="24" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1" Background="#000000" ToolTip="Original Color"/>
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="New" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,2" HorizontalAlignment="Center"/>
                            <Border x:Name="NewColorBorder" Width="34" Height="24" CornerRadius="3" BorderBrush="#CBD5E1" BorderThickness="1" Background="#000000" ToolTip="Selected Color"/>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Width="1" Fill="#E2E8F0" Margin="10,2"/>

                    <!-- Hex Code Field -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Hex" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBox x:Name="HexText" Width="78" Height="24" 
                                 FontFamily="Consolas, monospace" FontSize="12" FontWeight="Bold"
                                 TextAlignment="Center" TextChanged="HexText_TextChanged"/>
                    </StackPanel>

                    <!-- RGB Readout / Tweaking Inputs -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="2,0">
                            <TextBlock Text="R" FontSize="10" Foreground="#DC2626" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBox x:Name="RedText" Width="32" Height="24" TextAlignment="Center" FontSize="11" TextChanged="RgbText_TextChanged"/>
                        </StackPanel>
                        <StackPanel Margin="2,0">
                            <TextBlock Text="G" FontSize="10" Foreground="#16A34A" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBox x:Name="GreenText" Width="32" Height="24" TextAlignment="Center" FontSize="11" TextChanged="RgbText_TextChanged"/>
                        </StackPanel>
                        <StackPanel Margin="2,0">
                            <TextBlock Text="B" FontSize="10" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBox x:Name="BlueText" Width="32" Height="24" TextAlignment="Center" FontSize="11" TextChanged="RgbText_TextChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Preset Quick Swatches -->
            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="Standard Colors" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <WrapPanel x:Name="PresetPaletteWrapPanel" ItemWidth="21" ItemHeight="21">
                    <!-- Populated in code-behind -->
                </WrapPanel>
            </StackPanel>

            <!-- Dialog Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0" Click="CancelButton_Click" Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#475569" FontWeight="SemiBold"/>
                <Button Content="Select Color" Width="95" Height="28" Click="OkButton_Click" Background="#2563EB" BorderBrush="#1D4ED8" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
