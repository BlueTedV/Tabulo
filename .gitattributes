# Set default behavior: normalize text files and keep LF line endings across all platforms
# (This prevents Git from converting LF to CRLF in Windows working copies)
* text=auto eol=lf

# C# and .NET project files
*.cs text diff=csharp eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx text eol=lf
*.sln text eol=crlf

# Text, documentation, and vector graphics
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - never normalize or convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary
*.snk binary
*.pfx binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary
